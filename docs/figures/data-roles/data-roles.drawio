          <mxGeometry as="geometry" x="435" y="405" width="335" height="155" />
        </mxCell>
        <mxCell id="outer" value="Outputs from the outer fits&#10;8 fold scores per model&#10;Fixed 0.5 classification cutoff&#10;2 predictions per record, each&#10;excluded from fitting/tuning&#10;Average the 2 predictions" style="rounded=1;html=0;fillColor=#e8f1f7;strokeColor=#27617f;fontColor=#1f3443;fontSize=19;fontFamily=Arial;spacing=14;" vertex="1" parent="1">
