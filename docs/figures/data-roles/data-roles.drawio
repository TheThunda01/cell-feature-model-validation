          <mxGeometry as="geometry" x="870" y="575" width="350" height="175" />
        </mxCell>
        <mxCell id="limits" value="Interpretation boundaries&#10;Fold variability is not a confidence interval. Minimized threshold loss is tuning loss.&#10;The inspected holdout provides no fresh blind validation; it never feeds back into scripted choices." style="rounded=1;html=0;fillColor=#f3f5f7;strokeColor=#8195a3;fontColor=#1f3443;fontSize=18;fontFamily=Arial;spacing=14;" vertex="1" parent="1">
